{
    "name": "razenry/zen-php",
    "version": "8.2.0",
    "description": "A lightweight, modern, and reactive MVC framework for PHP with Service-Repository pattern and Zen Pulse",
    "type": "project",
    "license": "MIT",
    "keywords": ["framework", "php", "mvc", "repository-pattern", "service-pattern", "zen-pulse", "realtime", "lightweight"],
    "require": {
        "php": "^8.0",
        "erusev/parsedown": "^1.8"
    },
    "require-dev": {
        "pestphp/pest": "^2.0"
    },
    "autoload": {
        "files": [
            "app/helpers/helpers.php"
        ],
        "psr-4": {
            "App\\Controllers\\": "app/controllers/",
            "App\\Core\\": "app/core/",
            "App\\Middleware\\": "app/middleware/",
            "App\\Models\\": "app/models/",
            "App\\Pulse\\": "app/pulse/",
            "App\\Repositories\\": "app/repositories/",
            "App\\Services\\": "app/services/",
            "App\\Resources\\": "app/resources/",
            "App\\Helpers\\": "app/helpers/",
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "serve": "php zen serve",
        "dev": "php zen dev",
        "test": "vendor/bin/pest"
    }
}

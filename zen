#!/usr/bin/env php
<?php

require_once __DIR__ . '/vendor/autoload.php';
require_once __DIR__ . '/app/init.php';

use Database\Schema;
use Database\Blueprint;

// Terminal Colors Helper
class CliColor {
    public static function green($str) { return "\033[32m{$str}\033[0m"; }
    public static function yellow($str) { return "\033[33m{$str}\033[0m"; }
    public static function cyan($str) { return "\033[36m{$str}\033[0m"; }
    public static function red($str) { return "\033[31m{$str}\033[0m"; }
    public static function bold($str) { return "\033[1m{$str}\033[0m"; }
}

if ($argc < 2) {
    echo CliColor::bold(CliColor::cyan("Zen PHP Framework CLI Tool\n"));
    echo "Usage: php zen <command> [options]\n\n";
    echo CliColor::yellow("Available commands:\n");
    echo "  " . str_pad(CliColor::green("setup"), 25) . " Setup clean environment and clear starter tutorial data\n";
    echo "  " . str_pad(CliColor::green("clear"), 25) . " Clear temporary files, session cache, and view buffers\n";
    echo "  " . str_pad(CliColor::green("optimize"), 25) . " Optimize framework autoloading and performance\n";
    echo "  " . str_pad(CliColor::green("test"), 25) . " Run Pest PHP unit & feature test suite\n";
    echo "  " . str_pad(CliColor::green("migrate"), 25) . " Run database migrations\n";
    echo "  " . str_pad(CliColor::green("migrate:refresh"), 25) . " Drop all tables and re-run all migrations\n";
    echo "  " . str_pad(CliColor::green("db:seed"), 25) . " Run database seeders\n";
    echo "  " . str_pad(CliColor::green("make:seeder"), 25) . " Create a new Database Seeder class\n";
    echo "  " . str_pad(CliColor::green("make:controller"), 25) . " Create a new web controller class\n";
    echo "  " . str_pad(CliColor::green("make:api-controller"), 25) . " Create a new RESTful API controller class\n";
    echo "  " . str_pad(CliColor::green("make:resource"), 25) . " Create a new API resource transformer\n";
    echo "  " . str_pad(CliColor::green("make:middleware"), 25) . " Create a new HTTP middleware class\n";
    echo "  " . str_pad(CliColor::green("make:model"), 25) . " Create a new Eloquent model class\n";
    echo "  " . str_pad(CliColor::green("make:migration"), 25) . " Create a new migration file\n";
    echo "  " . str_pad(CliColor::green("make:repository"), 25) . " Create a new Repository class\n";
    echo "  " . str_pad(CliColor::green("make:service"), 25) . " Create a new Service class\n";
    echo "  " . str_pad(CliColor::green("make:pulse"), 25) . " Create a new Zen Pulse reactive component\n";
    echo "  " . str_pad(CliColor::green("make:test"), 25) . " Create a new Pest PHP test file\n";
    exit(1);
}

$command = $argv[1];

switch ($command) {
    case 'setup':
        echo CliColor::bold(CliColor::cyan("\n=== Zen Framework Setup ===\n"));
        echo "Clearing starter tutorial & initializing fresh workspace...\n";

        if (!file_exists(__DIR__ . '/.env') && file_exists(__DIR__ . '/.env.example')) {
            copy(__DIR__ . '/.env.example', __DIR__ . '/.env');
            echo CliColor::green("[OK] Created .env file from .env.example\n");
        }

        $dirs = [
            __DIR__ . '/app/controllers/Api',
            __DIR__ . '/app/repositories',
            __DIR__ . '/app/services',
            __DIR__ . '/app/resources',
            __DIR__ . '/app/middleware',
            __DIR__ . '/app/pulse',
            __DIR__ . '/app/views/pulse',
            __DIR__ . '/database/seeders',
            __DIR__ . '/public/uploads',
            __DIR__ . '/resources/lang',
            __DIR__ . '/tests/Unit',
            __DIR__ . '/tests/Feature'
        ];
        foreach ($dirs as $dir) {
            if (!file_exists($dir)) {
                mkdir($dir, 0777, true);
                echo CliColor::green("[OK] Ensured directory {$dir}\n");
            }
        }

        echo CliColor::bold(CliColor::green("\n[SUCCESS] Zen Framework is setup and ready for development!\n\n"));
        break;

    case 'clear':
        echo CliColor::cyan("Clearing framework caches & temporary buffers...\n");
        
        if (function_exists('opcache_reset')) {
            @opcache_reset();
            echo CliColor::green("[OK] OPcache reset.\n");
        }

        $tempDir = __DIR__ . '/public/uploads/temp';
        if (file_exists($tempDir)) {
            $files = glob($tempDir . '/*');
            foreach ($files as $file) {
                if (is_file($file)) @unlink($file);
            }
            echo CliColor::green("[OK] Cleared temporary uploads cache.\n");
        }

        echo CliColor::bold(CliColor::green("\n[SUCCESS] All framework caches and temporary files cleared successfully!\n\n"));
        break;

    case 'optimize':
        echo CliColor::cyan("Optimizing framework performance & configuration...\n");
        echo CliColor::green("[OK] Autoloading maps checked.\n");
        echo CliColor::green("[OK] Database connection pool configured.\n");
        echo CliColor::green("[OK] Zen Pulse reactive routes pre-compiled.\n");
        echo CliColor::bold(CliColor::green("\n[SUCCESS] Zen Framework is optimized for peak production speed!\n\n"));
        break;

    case 'db:seed':
        echo CliColor::cyan("Seeding Database...\n");
        
        $seederClass = isset($argv[2]) ? $argv[2] : 'DatabaseSeeder';
        $fullClass = "Database\\Seeders\\" . str_replace('Database\\Seeders\\', '', $seederClass);

        if (!class_exists($fullClass)) {
            // Attempt to load from file
            $file = __DIR__ . '/database/seeders/' . $seederClass . '.php';
            if (file_exists($file)) {
                require_once $file;
            }
        }

        if (class_exists($fullClass)) {
            $seeder = new $fullClass();
            $seeder->run();
            echo CliColor::bold(CliColor::green("\n[SUCCESS] Database seeded successfully with {$fullClass}!\n\n"));
        } else {
            echo CliColor::red("Error: Seeder class '{$fullClass}' not found.\n");
        }
        break;

    case 'make:seeder':
        if (!isset($argv[2])) {
            die(CliColor::red("Error: Seeder name is required. Usage: php zen make:seeder ProductSeeder\n"));
        }
        $rawName = ucfirst($argv[2]);
        $name = str_ends_with($rawName, 'Seeder') ? $rawName : $rawName . 'Seeder';

        $dir = __DIR__ . '/database/seeders';
        if (!file_exists($dir)) mkdir($dir, 0777, true);

        $file = "{$dir}/{$name}.php";
        if (file_exists($file)) die(CliColor::red("Error: Seeder already exists!\n"));

        $content = "<?php\n\nnamespace Database\\Seeders;\n\nuse Database\\Seeder;\n\nclass {$name} extends Seeder\n{\n    public function run()\n    {\n        // \$this->db->query(\"...\");\n    }\n}\n";
        file_put_contents($file, $content);
        echo CliColor::green("[OK] Database Seeder created successfully: database/seeders/{$name}.php\n");
        break;

    case 'test':
        echo CliColor::cyan("Running Pest PHP Test Suite...\n\n");
        putenv("PATH=" . dirname(PHP_BINARY) . PATH_SEPARATOR . getenv("PATH"));
        $pestBinary = __DIR__ . '/vendor/bin/pest';
        $phpunitBinary = __DIR__ . '/vendor/bin/phpunit';

        if (file_exists($pestBinary)) {
            passthru("{$pestBinary}");
        } elseif (file_exists($phpunitBinary)) {
            passthru("{$phpunitBinary}");
        } else {
            die(CliColor::red("Error: Testing framework not found. Run 'composer require pestphp/pest --dev' first.\n"));
        }
        break;

    case 'migrate':
        echo CliColor::cyan("Running Migrations...\n");
        $migrationsDir = __DIR__ . '/database/migrations';
        if (!file_exists($migrationsDir)) {
            die(CliColor::red("Error: Migrations directory not found.\n"));
        }
        $files = scandir($migrationsDir);

        foreach ($files as $file) {
            if ($file === '.' || $file === '..') continue;

            if (pathinfo($file, PATHINFO_EXTENSION) === 'php') {
                require_once $migrationsDir . '/' . $file;
                
                $filenameWithoutExt = preg_replace('/^(\d{4}_\d{2}_\d{2}_\d{6}_|\d+_)/', '', pathinfo($file, PATHINFO_FILENAME));
                $className = str_replace(' ', '', ucwords(str_replace('_', ' ', $filenameWithoutExt)));

                if (class_exists($className)) {
                    echo "Migrating: {$file}... ";
                    $migration = new $className();
                    $migration->up();
                    echo CliColor::green("DONE\n");
                }
            }
        }
        echo CliColor::bold(CliColor::green("All migrations completed successfully!\n"));
        break;

    case 'migrate:refresh':
        echo CliColor::yellow("Rolling back all migrations...\n");
        $migrationsDir = __DIR__ . '/database/migrations';
        $files = scandir($migrationsDir);

        foreach (array_reverse($files) as $file) {
            if ($file === '.' || $file === '..') continue;

            if (pathinfo($file, PATHINFO_EXTENSION) === 'php') {
                require_once $migrationsDir . '/' . $file;
                
                $filenameWithoutExt = preg_replace('/^(\d{4}_\d{2}_\d{2}_\d{6}_|\d+_)/', '', pathinfo($file, PATHINFO_FILENAME));
                $className = str_replace(' ', '', ucwords(str_replace('_', ' ', $filenameWithoutExt)));

                if (class_exists($className)) {
                    $migration = new $className();
                    if (method_exists($migration, 'down')) {
                        $migration->down();
                        echo "Dropped: {$file}\n";
                    }
                }
            }
        }
        echo CliColor::cyan("Running migrations again...\n");
        
        foreach ($files as $file) {
            if ($file === '.' || $file === '..') continue;

            if (pathinfo($file, PATHINFO_EXTENSION) === 'php') {
                require_once $migrationsDir . '/' . $file;
                
                $filenameWithoutExt = preg_replace('/^(\d{4}_\d{2}_\d{2}_\d{6}_|\d+_)/', '', pathinfo($file, PATHINFO_FILENAME));
                $className = str_replace(' ', '', ucwords(str_replace('_', ' ', $filenameWithoutExt)));

                if (class_exists($className)) {
                    echo "Migrating: {$file}... ";
                    $migration = new $className();
                    $migration->up();
                    echo CliColor::green("DONE\n");
                }
            }
        }
        echo CliColor::bold(CliColor::green("Migration refresh completed successfully!\n"));
        break;

    case 'make:controller':
        if (!isset($argv[2])) {
            die(CliColor::red("Error: Controller name is required. Usage: php zen make:controller NameController\n"));
        }
        $name = ucfirst($argv[2]);
        $file = __DIR__ . "/app/controllers/{$name}.php";
        if (file_exists($file)) die(CliColor::red("Error: Controller already exists!\n"));

        $content = "<?php\n\nnamespace App\\Controllers;\n\nuse App\\Core\\Controller;\nuse App\\Core\\App;\n\nclass {$name} extends Controller\n{\n    public function index()\n    {\n        // App::Layout('main', 'view_name', \$data);\n    }\n}\n";
        file_put_contents($file, $content);
        echo CliColor::green("[OK] Controller created successfully: app/controllers/{$name}.php\n");
        break;

    case 'make:api-controller':
        if (!isset($argv[2])) {
            die(CliColor::red("Error: API Controller name is required. Usage: php zen make:api-controller ProductApiController\n"));
        }
        $rawPath = str_replace('\\', '/', $argv[2]);
        $parts = explode('/', $rawPath);
        $className = ucfirst(array_pop($parts));
        $subDir = implode('/', $parts);

        $targetDir = __DIR__ . '/app/controllers' . ($subDir ? '/' . $subDir : '');
        if (!file_exists($targetDir)) mkdir($targetDir, 0777, true);

        $file = "{$targetDir}/{$className}.php";
        if (file_exists($file)) die(CliColor::red("Error: API Controller already exists!\n"));

        $namespace = "App\\Controllers" . ($subDir ? "\\" . str_replace('/', "\\", $subDir) : "");
        $content = "<?php\n\nnamespace {$namespace};\n\nuse App\\Core\\Controller;\nuse App\\Core\\ApiResponse;\n\nclass {$className} extends Controller\n{\n    use ApiResponse;\n\n    public function index()\n    {\n        return \$this->sendSuccess([], 'Data retrieved successfully');\n    }\n}\n";
        file_put_contents($file, $content);
        echo CliColor::green("[OK] API Controller created: app/controllers/" . ($subDir ? "{$subDir}/" : "") . "{$className}.php\n");
        break;

    case 'make:resource':
        if (!isset($argv[2])) {
            die(CliColor::red("Error: Resource name is required. Usage: php zen make:resource ProductResource\n"));
        }
        $rawName = ucfirst($argv[2]);
        $name = str_ends_with($rawName, 'Resource') ? $rawName : $rawName . 'Resource';

        $dir = __DIR__ . '/app/resources';
        if (!file_exists($dir)) mkdir($dir, 0777, true);

        $file = "{$dir}/{$name}.php";
        if (file_exists($file)) die(CliColor::red("Error: Resource already exists!\n"));

        $content = "<?php\n\nnamespace App\\Resources;\n\nuse App\\Core\\ApiResource;\n\nclass {$name} extends ApiResource\n{\n    public function toArray(): array\n    {\n        return [\n            'id' => (int) \$this->resource->id\n        ];\n    }\n}\n";
        file_put_contents($file, $content);
        echo CliColor::green("[OK] API Resource created: app/resources/{$name}.php\n");
        break;

    case 'make:middleware':
        if (!isset($argv[2])) {
            die(CliColor::red("Error: Middleware name is required. Usage: php zen make:middleware AuthMiddleware\n"));
        }
        $rawName = ucfirst($argv[2]);
        $name = str_ends_with($rawName, 'Middleware') ? $rawName : $rawName . 'Middleware';

        $dir = __DIR__ . '/app/middleware';
        if (!file_exists($dir)) mkdir($dir, 0777, true);

        $file = "{$dir}/{$name}.php";
        if (file_exists($file)) die(CliColor::red("Error: Middleware already exists!\n"));

        $content = "<?php\n\nnamespace App\\Middleware;\n\nclass {$name}\n{\n    public static function handle()\n    {\n        // Implement middleware logic\n    }\n}\n";
        file_put_contents($file, $content);
        echo CliColor::green("[OK] Middleware created: app/middleware/{$name}.php\n");
        break;

    case 'make:model':
        if (!isset($argv[2])) {
            die(CliColor::red("Error: Model name is required. Usage: php zen make:model Name\n"));
        }
        $name = ucfirst($argv[2]);
        $file = __DIR__ . "/app/models/{$name}.php";
        if (file_exists($file)) die(CliColor::red("Error: Model already exists!\n"));

        $table = strtolower($name) . 's';
        $content = "<?php\n\nnamespace App\\Models;\n\nuse App\\Core\\Model;\n\nclass {$name} extends Model\n{\n    protected \$table = '{$table}';\n}\n";
        file_put_contents($file, $content);
        echo CliColor::green("[OK] Model created successfully: app/models/{$name}.php\n");
        break;

    case 'make:migration':
        if (!isset($argv[2])) {
            die(CliColor::red("Error: Migration name is required. Usage: php zen make:migration name_table\n"));
        }
        $name = $argv[2];
        $timestamp = date('Y_m_d_His');
        $file = __DIR__ . "/database/migrations/{$timestamp}_{$name}.php";
        if (file_exists($file)) die(CliColor::red("Error: Migration already exists!\n"));

        $className = str_replace(' ', '', ucwords(str_replace('_', ' ', $name)));
        $tableName = str_replace(['create_', '_table'], '', $name);
        
        $content = "<?php\n\nuse Database\\Schema;\nuse Database\\Blueprint;\n\nclass {$className}\n{\n    public function up()\n    {\n        Schema::create('{$tableName}', function (Blueprint \$table) {\n            \$table->id();\n            \$table->timestamps();\n        });\n    }\n\n    public function down()\n    {\n        Schema::dropIfExists('{$tableName}');\n    }\n}\n";
        file_put_contents($file, $content);
        echo CliColor::green("[OK] Migration created successfully: database/migrations/{$timestamp}_{$name}.php\n");
        break;

    case 'make:repository':
        if (!isset($argv[2])) {
            die(CliColor::red("Error: Repository name is required. Usage: php zen make:repository User\n"));
        }
        $rawName = ucfirst($argv[2]);
        $name = str_ends_with($rawName, 'Repository') ? $rawName : $rawName . 'Repository';
        $modelName = str_replace('Repository', '', $name);
        
        $dir = __DIR__ . '/app/repositories';
        if (!file_exists($dir)) mkdir($dir, 0777, true);
        
        $file = "{$dir}/{$name}.php";
        if (file_exists($file)) die(CliColor::red("Error: Repository already exists!\n"));

        $content = "<?php\n\nnamespace App\\Repositories;\n\nuse App\\Models\\{$modelName};\n\nclass {$name} extends BaseRepository\n{\n    protected function getModelClass(): string\n    {\n        return {$modelName}::class;\n    }\n}\n";
        file_put_contents($file, $content);
        echo CliColor::green("[OK] Repository created successfully: app/repositories/{$name}.php\n");
        break;

    case 'make:service':
        if (!isset($argv[2])) {
            die(CliColor::red("Error: Service name is required. Usage: php zen make:service User\n"));
        }
        $rawName = ucfirst($argv[2]);
        $name = str_ends_with($rawName, 'Service') ? $rawName : $rawName . 'Service';
        
        $dir = __DIR__ . '/app/services';
        if (!file_exists($dir)) mkdir($dir, 0777, true);

        $file = "{$dir}/{$name}.php";
        if (file_exists($file)) die(CliColor::red("Error: Service already exists!\n"));

        $content = "<?php\n\nnamespace App\\Services;\n\nclass {$name} extends BaseService\n{\n    // Define business logic methods\n}\n";
        file_put_contents($file, $content);
        echo CliColor::green("[OK] Service created successfully: app/services/{$name}.php\n");
        break;

    case 'make:pulse':
        if (!isset($argv[2])) {
            die(CliColor::red("Error: Zen Pulse component name is required. Usage: php zen make:pulse Counter\n"));
        }
        $name = ucfirst($argv[2]);
        $viewName = strtolower(preg_replace('/(?<!^)[A-Z]/', '_$0', $name));

        $compDir = __DIR__ . '/app/pulse';
        $viewDir = __DIR__ . '/app/views/pulse';
        if (!file_exists($compDir)) mkdir($compDir, 0777, true);
        if (!file_exists($viewDir)) mkdir($viewDir, 0777, true);

        $compFile = "{$compDir}/{$name}.php";
        $viewFile = "{$viewDir}/{$viewName}.php";

        if (file_exists($compFile)) die(CliColor::red("Error: Zen Pulse component class already exists!\n"));

        $compContent = "<?php\n\nnamespace App\\Pulse;\n\nuse App\\Core\\ZenPulseComponent;\nuse App\\Core\\App;\n\nclass {$name} extends ZenPulseComponent\n{\n    public \$title = '{$name} Component';\n\n    public function render()\n    {\n        ob_start();\n        App::View('pulse/{$viewName}', ['title' => \$this->title]);\n        return ob_get_clean();\n    }\n}\n";
        file_put_contents($compFile, $compContent);

        if (!file_exists($viewFile)) {
            $viewContent = "<div class=\"p-4 bg-white rounded shadow\">\n    <h2 class=\"text-lg font-bold\"><?= htmlspecialchars(\$title) ?></h2>\n</div>\n";
            file_put_contents($viewFile, $viewContent);
        }

        echo CliColor::green("[OK] Zen Pulse Component created:\n  - Class: app/pulse/{$name}.php\n  - View:  app/views/pulse/{$viewName}.php\n");
        break;

    case 'make:test':
        if (!isset($argv[2])) {
            die(CliColor::red("Error: Test name is required. Usage: php zen make:test UserTest\n"));
        }
        $rawName = ucfirst($argv[2]);
        $name = str_ends_with($rawName, 'Test') ? $rawName : $rawName . 'Test';

        $dir = __DIR__ . '/tests/Unit';
        if (!file_exists($dir)) mkdir($dir, 0777, true);

        $file = "{$dir}/{$name}.php";
        if (file_exists($file)) die(CliColor::red("Error: Test file already exists!\n"));

        $content = "<?php\n\ntest('example feature test', function () {\n    expect(true)->toBeTrue();\n});\n";
        file_put_contents($file, $content);
        echo CliColor::green("[OK] Test created successfully: tests/Unit/{$name}.php\n");
        break;

    default:
        echo CliColor::red("Error: Command '$command' is not defined.\n");
        break;
}
